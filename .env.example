# Copy to .env. Nothing here is secret; the Cloud SQL password lives in Secret Manager (wiw-db-password).
# ---- Gemini: live | replay | off  (replay = cache only + deterministic fallback, no network)
GEMINI_MODE=replay
# ---- Backends: local (default, no cloud) or cloud
DB_BACKEND=sqlite            # sqlite | cloudsql
STORAGE_BACKEND=local        # local | gcs
EVENTS_BACKEND=local         # local | bigquery   (events are always written locally too)
SEARCH_BACKEND=local         # local | vertex
# ---- Optional overrides (defaults come from config/cloud.yaml)
# GCP_PROJECT=atelieros-cup26
# SQLITE_PATH=local/wiw.db
# DB_PASSWORD=               # only if you do not want it read from Secret Manager
